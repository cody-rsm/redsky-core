# RedSky configuration. Copy to .env.local for development; on Railway set these as service variables.
# Never commit real values. Every variable is optional unless marked REQUIRED for that environment.

# --- Core -------------------------------------------------------------------------------------------------
# Public URL of this RedSky deployment (REQUIRED in production; https). Used for the Entra redirect URI.
REDSKY_APP_URL=http://localhost:3000
# RedSky's OWN PostgreSQL database (REQUIRED). Never Twenty's database — the migration runner refuses it.
# On Railway: reference the RedSky Postgres service, e.g. ${{redsky-postgres.DATABASE_URL}}
REDSKY_DATABASE_URL=postgres://redsky:redsky_local_dev@localhost:5432/redsky_dev
# demo = labelled sample data from the prototype; production = real sources only, never sample data.
# Defaults: demo outside production builds, production in production builds.
REDSKY_DATA_MODE=demo
# Firm time zone for dates and greetings (IANA name).
REDSKY_TIMEZONE=America/New_York
LOG_LEVEL=info

# --- Sessions & encryption ------------------------------------------------------------------------------
# At least 32 random characters (REQUIRED with Entra). Generate: openssl rand -base64 48
REDSKY_SESSION_SECRET=
# Session lifetime in hours (1–72).
REDSKY_SESSION_TTL_HOURS=12
# 32-byte key, base64 (REQUIRED in production for Workstyle). Generate: openssl rand -base64 32
# Losing or rotating this key makes stored Workstyle data unreadable.
REDSKY_ENCRYPTION_KEY=

# --- Microsoft Entra ID (production sign-in) ------------------------------------------------------------
# Single-tenant app registration. Redirect URI: ${REDSKY_APP_URL}/api/auth/entra/callback
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=
# App role (in the app registration) that makes a user a RedSky administrator.
AUTH_ENTRA_ADMIN_ROLE=RedSky.Admin

# --- Development only -----------------------------------------------------------------------------------
# Persona sign-in for local development. Ignored by production builds (NODE_ENV=production) whatever its value.
AUTH_DEV_ENABLED=true

# --- RedSky AI ------------------------------------------------------------------------------------------
# anthropic | none. With "none", production shows "RedSky AI isn't configured"; demo mode uses simulated answers.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium

# --- Twenty CRM (read-only adapter) ---------------------------------------------------------------------
# Base URL of the Twenty server's public API (no trailing path) and a dedicated, role-scoped API key.
# Leave empty until RSM provides them; CRM-backed views show "not connected" meanwhile.
TWENTY_API_URL=
TWENTY_API_KEY=

# --- Workstyle Intelligence -----------------------------------------------------------------------------
# Keep the uploaded PDF (encrypted) after extraction. Default false: only the reviewed scores are stored.
WORKSTYLE_RETAIN_ORIGINAL=false
