# redsky-ocr settings with their defaults. Copy to .env for local runs; never commit it.
# On Railway, use railway.env.example instead.

# Required
REDSKY_OCR_DATABASE_URL=postgresql://redsky_ocr:CHANGE_ME@localhost:5432/redsky_ocr
# First deploy only: superuser URL that creates the login and database named
# in REDSKY_OCR_DATABASE_URL. Remove it once the service has started.
REDSKY_OCR_ADMIN_DATABASE_URL=

# Callers. Secret: comma-separated bearer tokens the RedSky API uses, at least
# 32 characters each (openssl rand -hex 32). Several may be set during rotation.
REDSKY_OCR_SERVICE_TOKENS=
# Let Twenty users call with their own Twenty access tokens. Off in the target
# layout, where every call comes through the RedSky API.
REDSKY_OCR_ACCEPT_TWENTY_TOKENS=false
REDSKY_OCR_AUTH_CACHE_SECONDS=60

# Source: the RedSky documents bucket (S3 API). Unset turns the storage source off.
REDSKY_OCR_STORAGE_BUCKET=
REDSKY_OCR_STORAGE_ENDPOINT=
REDSKY_OCR_STORAGE_REGION=auto
# Secrets.
REDSKY_OCR_STORAGE_ACCESS_KEY_ID=
REDSKY_OCR_STORAGE_SECRET_ACCESS_KEY=
# virtual (Railway buckets, AWS) or path (MinIO, moto).
REDSKY_OCR_STORAGE_ADDRESSING_STYLE=virtual
# Keys outside this prefix are refused.
REDSKY_OCR_STORAGE_KEY_PREFIX=documents/

# Events for the RedSky API. Secret: the signing secret (openssl rand -hex 32).
REDSKY_OCR_EVENTS_URL=
REDSKY_OCR_EVENTS_SECRET=

# Source: Twenty attachments, while Twenty owns CRM records. Unset turns it off.
REDSKY_OCR_TWENTY_URL=
# Twenty's SERVER_URL when it differs from REDSKY_OCR_TWENTY_URL; its signed file
# links are then fetched over REDSKY_OCR_TWENTY_URL.
REDSKY_OCR_TWENTY_PUBLIC_URL=
# Secret: API key of the read-only "RedSky OCR" role in Twenty.
REDSKY_OCR_TWENTY_API_KEY=
# Secret: the webhook secret set on Twenty's webhook. Unset disables the receiver.
REDSKY_OCR_TWENTY_WEBHOOK_SECRET=
REDSKY_OCR_TWENTY_TIMEOUT_SECONDS=15
# Tenant recorded for Twenty attachments; defaults to Twenty's workspace id.
# The RedSky API must send the same value as X-RedSky-Tenant-Id.
REDSKY_OCR_TWENTY_TENANT_ID=
# Extra hosts file downloads may go to, for example the S3 endpoint when
# Twenty runs with STORAGE_S3_PRESIGNED_URL_ENABLED=true. Comma-separated.
REDSKY_OCR_FILE_DOWNLOAD_HOSTS=
REDSKY_OCR_AUTO_PROCESS_ATTACHMENTS=true
# Sweep for attachments whose webhook never arrived; 0 turns it off.
REDSKY_OCR_RECONCILE_INTERVAL_SECONDS=600

# Bind address. Empty: "::" when the host has IPv6, else 0.0.0.0.
REDSKY_OCR_HOST=
PORT=8080

# Limits
REDSKY_OCR_MAX_FILE_BYTES=52428800
REDSKY_OCR_MAX_PAGES=500
REDSKY_OCR_MAX_IMAGE_PIXELS=60000000
REDSKY_OCR_MAX_ZIP_ENTRIES=5000
REDSKY_OCR_MAX_ZIP_UNCOMPRESSED_BYTES=314572800
REDSKY_OCR_MAX_ZIP_COMPRESSION_RATIO=150

# Worker
REDSKY_OCR_WORKER_ENABLED=true
REDSKY_OCR_WORKER_CONCURRENCY=1
REDSKY_OCR_WORKER_POLL_SECONDS=2
REDSKY_OCR_JOB_TIMEOUT_SECONDS=900
REDSKY_OCR_JOB_MAX_ATTEMPTS=3
# 0 leaves memory to the container limit (an address-space cap breaks torch).
REDSKY_OCR_JOB_MEMORY_LIMIT_MB=0
REDSKY_OCR_WORK_DIR=/tmp/redsky-ocr

# Extraction
REDSKY_OCR_DEFAULT_ENGINE=auto
REDSKY_OCR_OCR_LANGUAGES=eng
REDSKY_OCR_OCR_DPI=300
REDSKY_OCR_OCR_MIN_CONFIDENCE=60
# Set by the Docker image (/opt/models).
REDSKY_OCR_DOCLING_ARTIFACTS_PATH=
REDSKY_OCR_DOCLING_TABLE_STRUCTURE=true
REDSKY_OCR_GRANITE_DOCLING_MODE=off
REDSKY_OCR_GRANITE_DOCLING_API_URL=
REDSKY_OCR_GRANITE_DOCLING_API_KEY=

# Optional malware scanning through clamd
REDSKY_OCR_CLAMAV_HOST=
REDSKY_OCR_CLAMAV_PORT=3310

REDSKY_OCR_LOG_LEVEL=INFO
