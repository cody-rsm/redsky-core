RAILWAY_DOCKERFILE_PATH=Dockerfile
WITH_DOCLING_MODELS=true
WITH_GRANITE_DOCLING=false
PORT=8080
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=300
REDSKY_OCR_DATABASE_URL=postgresql://redsky_ocr:${{REDSKY_OCR_DB_PASSWORD}}@${{redsky-postgres.PGHOST}}:${{redsky-postgres.PGPORT}}/redsky_ocr
REDSKY_OCR_ADMIN_DATABASE_URL=${{redsky-postgres.DATABASE_URL}}
REDSKY_OCR_STORAGE_BUCKET=${{redsky-documents.BUCKET}}
REDSKY_OCR_STORAGE_ENDPOINT=${{redsky-documents.ENDPOINT}}
REDSKY_OCR_STORAGE_REGION=${{redsky-documents.REGION}}
REDSKY_OCR_STORAGE_ACCESS_KEY_ID=${{redsky-documents.ACCESS_KEY_ID}}
REDSKY_OCR_STORAGE_SECRET_ACCESS_KEY=${{redsky-documents.SECRET_ACCESS_KEY}}
REDSKY_OCR_STORAGE_KEY_PREFIX=documents/
REDSKY_OCR_EVENTS_URL=http://${{redsky-web.RAILWAY_PRIVATE_DOMAIN}}:3000/api/internal/ocr/events
REDSKY_OCR_ACCEPT_TWENTY_TOKENS=false
REDSKY_OCR_WORKER_CONCURRENCY=1
REDSKY_OCR_JOB_TIMEOUT_SECONDS=900
REDSKY_OCR_MAX_FILE_BYTES=52428800
REDSKY_OCR_MAX_PAGES=500
REDSKY_OCR_GRANITE_DOCLING_MODE=off
# Stage 2 only (docs/DEPLOYMENT.md §13): Twenty attachments. Leave these commented out until then;
# without REDSKY_OCR_TWENTY_URL the twenty source is off.
# REDSKY_OCR_TWENTY_URL=http://${{twenty-server.RAILWAY_PRIVATE_DOMAIN}}:3000
# REDSKY_OCR_TWENTY_PUBLIC_URL=https://${{twenty-server.RAILWAY_PUBLIC_DOMAIN}}
# REDSKY_OCR_TWENTY_TENANT_ID=rsm
