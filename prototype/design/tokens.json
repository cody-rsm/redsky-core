{
  "brand": {
    "Crimson": "#941B1E",
    "Coffee": "#5B332E",
    "Cactus": "#162F1C",
    "Leatherbound": "#78522B",
    "Dust Cloud": "#EEEBDF",
    "Palomino": "#ECDCB9",
    "Whisper": "#CCD9E2"
  },
  "fonts": {
    "display": "'Faculty Glyphic', Georgia, serif",
    "ui": "'Fira Sans', system-ui, sans-serif",
    "mono": "'Fira Mono', ui-monospace, monospace"
  },
  "radius": {
    "chip": "5px",
    "button": "7px",
    "input": "8px",
    "card": "12px",
    "modal": "14px",
    "hero": "16-20px"
  },
  "semantic": {
    "--bg": {
      "role": "background",
      "light": "#F7F5EF",
      "dark": "#161210"
    },
    "--sf": {
      "role": "surface",
      "light": "#FFFEFB",
      "dark": "#1D1815"
    },
    "--sf2": {
      "role": "surface-2",
      "light": "#F2EFE8",
      "dark": "#241E1A"
    },
    "--hov": {
      "role": "hover",
      "light": "#EFEBE3",
      "dark": "#2A231F"
    },
    "--bd": {
      "role": "border",
      "light": "#E6E1D6",
      "dark": "#322A25"
    },
    "--bd2": {
      "role": "border-strong",
      "light": "#D6CFC1",
      "dark": "#45392F"
    },
    "--tx": {
      "role": "text",
      "light": "#1E1916",
      "dark": "#EEEBDF"
    },
    "--tx2": {
      "role": "text-secondary",
      "light": "#5C534D",
      "dark": "#BDB3A8"
    },
    "--tx3": {
      "role": "text-tertiary",
      "light": "#736961",
      "dark": "#968C82"
    },
    "--ac": {
      "role": "accent (fills)",
      "light": "#941B1E",
      "dark": "#B3282C"
    },
    "--ach": {
      "role": "accent hover",
      "light": "#7D1619",
      "dark": "#C4353A"
    },
    "--act": {
      "role": "accent text",
      "light": "#941B1E",
      "dark": "#E8726F"
    },
    "--acs": {
      "role": "accent soft",
      "light": "#F6E9E6",
      "dark": "#331C1A"
    },
    "--ring": {
      "role": "focus ring",
      "light": "rgba(148,27,30,.16)",
      "dark": "rgba(232,114,111,.22)"
    },
    "--ai": {
      "role": "AI text",
      "light": "#2F5674",
      "dark": "#9FBBD0"
    },
    "--aib": {
      "role": "AI background",
      "light": "#EAF0F5",
      "dark": "#1C252C"
    },
    "--aibd": {
      "role": "AI border",
      "light": "#CCD9E2",
      "dark": "#2C3B47"
    },
    "--ok": {
      "role": "positive",
      "light": "#2E6A45",
      "dark": "#7FB892"
    },
    "--okb": {
      "role": "positive background",
      "light": "#E4EEE6",
      "dark": "#1B2A20"
    },
    "--wn": {
      "role": "warning",
      "light": "#8A5A1F",
      "dark": "#D8A35E"
    },
    "--wnb": {
      "role": "warning background",
      "light": "#F4EAD9",
      "dark": "#2E2417"
    },
    "--sb": {
      "role": "sidebar",
      "light": "#F1EEE6",
      "dark": "#120F0D"
    },
    "--sh": {
      "role": "shadow",
      "light": "0 1px 2px rgba(40,24,20,.05),0 3px 12px rgba(40,24,20,.04)",
      "dark": "0 1px 2px rgba(0,0,0,.3)"
    },
    "--shl": {
      "role": "shadow large",
      "light": "0 18px 48px rgba(40,24,20,.18),0 2px 6px rgba(40,24,20,.06)",
      "dark": "0 18px 48px rgba(0,0,0,.55)"
    },
    "--ov": {
      "role": "overlay",
      "light": "rgba(30,20,16,.26)",
      "dark": "rgba(0,0,0,.5)"
    }
  }
}